NODE_ENV=development

APP_NAME=Fastify APP
APP_PORT=3000
APP_URL=http://localhost:3000
APP_TIMEZONE=UTC
APP_KEY=your-app-key

# REQUIRED, no default. JWT_SECRET signs access tokens (1 day); JWT_REFRESH_SECRET signs
# refresh tokens (7 days). The process refuses to boot unless each is at least 32 characters,
# not one of the placeholders below, and the two differ. Replace both before the first run:
#   openssl rand -base64 48
JWT_SECRET=change-me-before-running
JWT_REFRESH_SECRET=change-me-too-before-running

# API docs (Scalar UI at /docs, spec at /docs/openapi.json). The only switch, independent of
# NODE_ENV, and false when unset. On for local development; leave it off everywhere else.
ENABLE_API_DOCS=true

LOG_LEVEL=info

# With docker compose, use service hostnames instead of localhost:
#   postgres / redis / clickhouse (e.g. @postgres:5432, REDIS_HOST=redis)
# Keep values UNQUOTED: `docker run --env-file` passes quotes literally.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/clean_fastify
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=5000
# Debug-level SQL log (statement text and parameter count, never parameter
# values). Needs LOG_LEVEL=debug to show. Leave off outside local development.
DB_LOG_QUERIES=false

# Used by docker-compose.yml to provision the postgres container. Keep in sync with DATABASE_URL.
POSTGRES_DB=clean_fastify
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# docker-compose.yml only: the postgres container logs every statement slower
# than this many milliseconds (log_min_duration_statement). -1 disables it.
POSTGRES_SLOW_QUERY_MS=100

CLICKHOUSE_HOST=http://localhost:8123
CLICKHOUSE_USER=app
CLICKHOUSE_PASSWORD=secret
CLICKHOUSE_DATABASE=app

# Front-end base URL used in verification and reset links.
CLIENT_URL=http://localhost:3000

# docker-compose.yml starts redis with this password.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=password123
REDIS_DB=0

# envalid treats `VAR=` as a provided empty string, which defeats the default and fails
# validation, so every MAIL_* line carries a placeholder.
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your_email@example.com
MAIL_PASS=your_email_password
MAIL_FROM=Fastify <your_email@example.com>

# CORS: comma-separated allowed origins. Empty allows every origin.
ALLOWED_HOST=
